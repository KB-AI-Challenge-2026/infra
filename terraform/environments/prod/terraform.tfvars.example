# 저장소 기본값은 어떤 운영 자원도 만들지 않습니다.
enable_aws_resources = false
enable_ecs_services  = false
aws_region           = "ap-northeast-2"

# 아래 값은 계정·비용·보안·개인정보 검토 후 별도 *.auto.tfvars 또는 CI 변수로 입력합니다.
enable_nat_gateway       = false
backend_ingress_cidrs    = []
backend_certificate_arn  = null
db_instance_class        = null
db_allocated_storage     = null
db_backup_retention_days = null
document_retention_days  = null
document_bucket_name     = null
backend_image_uri        = ""
aiserver_image_uri       = ""
container_cpu_architecture = "X86_64"

service_environment = {
  backend = {
    SPRING_PROFILES_ACTIVE = "prod"
  }
  aiserver = {
    AI_MODEL_PROVIDER = "rules"
  }
}

service_secrets = {
  backend  = {}
  aiserver = {}
}
